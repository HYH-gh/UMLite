@diagram class "图2-1 超市业务涉众模型"

// ================= 抽象层：涉众分类 =================
abstract class 涉众 {
    + 名称: String
    + 类别: 外部/内部
    + 关注点: String
    + 期望: String
    + 影响力: 高/中/低
    + 利益程度: 高/中/低
    + 态度: 支持/中立/反对
}

abstract class 外部涉众
abstract class 内部涉众

外部涉众 --|> 涉众 : 泛化
内部涉众 --|> 涉众 : 泛化

// ================= 被建模的业务本体 =================
class 超市业务 {
    + 卖场与商品陈列
    + 商品与供应链
    + 收银与结算
    + 会员与促销
    + 超市业务管理系统
}

// ================= 外部涉众 =================
class 顾客 {
    + 关注点: 新鲜、实惠、结账快、退换方便
    + 期望: 一站式购齐、明码标价
    + 影响力: 高
    + 态度: 支持（价格敏感、易流失）
}

class 会员顾客 {
    + 关注点: 会员价、积分、专属券、生日礼
    + 期望: 权益可见、核销顺畅、积分可查
    + 影响力: 高
    + 态度: 支持
}

class 供应商 {
    + 关注点: 上架率、账期、促销资源、损耗判责
    + 期望: 结算准时、退货规则清晰
    + 影响力: 高
    + 态度: 中立（谈判型）
}

class 集团总部 {
    + 关注点: 统一价格形象、毛利、KPI、系统标准化
    + 期望: 门店执行到位、数据可汇总
    + 影响力: 高
    + 态度: 支持
}

class 支付机构 {
    + 关注点: 交易成功率、费率、对账文件、合规
    + 期望: 接口稳定、差错可追溯
    + 影响力: 中
    + 态度: 中立
}

class 政府监管部门 {
    + 关注点: 食品安全溯源、明码标价、计量准确、消防
    + 期望: 索证索票齐全、可随时抽查
    + 影响力: 高（强制性）
    + 态度: 中立（合规约束）
}

class 商场物业 {
    + 关注点: 租金、营业时间、客流、垃圾与噪音
    + 期望: 履约、不扰民
    + 影响力: 中
    + 态度: 中立
}

class 周边居民与竞争者 {
    + 关注点: 便利性、价格形象、社区影响
    + 期望: 低价便利 / 市场份额
    + 影响力: 低
    + 态度: 中立
}

// ================= 内部涉众（业务工人与管理层） =================
class 店长 {
    + 关注点: 销售额、毛利、损耗率、人效、满意度
    + 期望: 数据实时、决策有依据
    + 影响力: 高
    + 态度: 支持
}

class 收银员 {
    + 关注点: 结账速度、错账责任、排班、系统易用
    + 期望: 扫码快、少手工、差错可回溯
    + 影响力: 中
    + 态度: 支持（关注操作负担）
}

class 理货员 {
    + 关注点: 补货效率、陈列标准、报损判责
    + 期望: 缺货提醒准确、PDA 好用
    + 影响力: 中
    + 态度: 支持
}

class 收货员 {
    + 关注点: 验收效率、单据一致、库位准确
    + 期望: 收货单与订单自动比对
    + 影响力: 中
    + 态度: 支持
}

class 防损员 {
    + 关注点: 偷盗与损耗、监控、盘点差异
    + 期望: 异常交易可预警
    + 影响力: 中
    + 态度: 中立（可能增加流程环节）
}

class 客服专员 {
    + 关注点: 退换货授权、投诉时效
    + 期望: 小票与订单可快速检索
    + 影响力: 中
    + 态度: 支持
}

class 财务对账员 {
    + 关注点: 日结差异、渠道对账、发票
    + 期望: 账实一致、差异可定位
    + 影响力: 中
    + 态度: 支持
}

class IT运维 {
    + 关注点: 系统可用性、POS 与网络、数据备份
    + 期望: 故障可监控、可回滚
    + 影响力: 中
    + 态度: 支持
}

// ================= 泛化关系 =================
顾客 --|> 外部涉众 : 泛化
会员顾客 --|> 顾客 : 泛化
供应商 --|> 外部涉众 : 泛化
集团总部 --|> 外部涉众 : 泛化
支付机构 --|> 外部涉众 : 泛化
政府监管部门 --|> 外部涉众 : 泛化
商场物业 --|> 外部涉众 : 泛化
周边居民与竞争者 --|> 外部涉众 : 泛化

店长 --|> 内部涉众 : 泛化
收银员 --|> 内部涉众 : 泛化
理货员 --|> 内部涉众 : 泛化
收货员 --|> 内部涉众 : 泛化
防损员 --|> 内部涉众 : 泛化
客服专员 --|> 内部涉众 : 泛化
财务对账员 --|> 内部涉众 : 泛化
IT运维 --|> 内部涉众 : 泛化

// ================= 关联：涉众与超市业务 =================
外部涉众 "*" --> "1" 超市业务 : 提出关注与期望
内部涉众 "*" --> "1" 超市业务 : 参与并执行业务

// ================= 涉众之间的利益冲突 =================
顾客 .. 供应商 : «冲突» 低价形象 vs 供货毛利
顾客 .. 收银员 : «冲突» 结账速度 vs 逐件核对
理货员 .. 供应商 : «冲突» 生鲜损耗判责
集团总部 .. 供应商 : «冲突» 账期与促销投入
顾客 .. 会员顾客 : «冲突» 普遍低价 vs 会员专属权益

// ================= 说明 =================
notice "建模说明" {
    1. 泛化：外部涉众 / 内部涉众 是抽象涉众类；
       会员顾客 是 顾客 的特化（多一层权益关系）。
    2. 关联：所有涉众都与"超市业务"发生关注或参与关系，
       多重度 * : 1 表示多个涉众共同关注同一业务。
    3. 虚线 «冲突» 表示两涉众关注点相互制约，
       在涉众报告中给出协调策略。
}

notice "优先级提示" {
    高影响 + 高利益：顾客、会员顾客、店长、集团总部、
                    供应商、政府监管部门（关键玩家）
    高影响 + 低利益：支付机构、商场物业（保持满意）
    低影响 + 高利益：收银员、理货员、客服专员（保持告知）
}
