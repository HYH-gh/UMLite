@diagram class "图4-1 超市业务对象模型"

// ============================================================
// 一、业务实体：人（顾客侧）
// ============================================================
class 顾客 {
    - 顾客编号: String
    - 手机号: String
    - 是否会员: Boolean
    + 出示会员码(): String
    + 付款(金额: Money): Boolean
}

class 会员 {
    - 会员卡号: String
    - 等级: 普通/银卡/金卡
    - 积分余额: Int
    - 优惠券列表: List
    + 累计积分(消费额: Money)
    + 核销优惠券(券号: String): Boolean
    + 查询权益(): List
}

// ============================================================
// 二、业务实体：商品与价格
// ============================================================
class 商品 {
    - 条码: String
    - 名称: String
    - 规格: String
    - 售价: Money
    - 进价: Money
    - 是否称重: Boolean
    - 保质期天数: Int
    + 计算售价(会员: 会员): Money
    + 判断临期(): Boolean
}

class 品类 {
    - 品类编码: String
    - 名称: String
    - 毛利目标: Percent
    + 汇总销售(): Money
}

class 促销活动 {
    - 活动编号: String
    - 类型: 特价/满减/买赠/会员价
    - 起止时间: DateTime
    - 适用门店: List
    + 匹配商品(条码: String): Boolean
    + 计算优惠(件数: Int, 金额: Money): Money
}

class 货架陈列位 {
    - 货位编码: String
    - 区域: String
    - 层数: Int
    - 陈列面数: Int
    + 生成补货任务()
}

// ============================================================
// 三、业务实体：库存与供应链
// ============================================================
class 库存 {
    - 现存数量: Int
    - 锁定数量: Int
    - 安全库存: Int
    - 库位: String
    + 可用量(): Int
    + 扣减(数量: Int): Boolean
    + 触发补货预警(): Boolean
}

class 库存批次 {
    - 批次号: String
    - 生产日期: Date
    - 到期日: Date
    - 批次数量: Int
    + 先进先出扣减(数量: Int)
}

class 供应商 {
    - 供应商编码: String
    - 名称: String
    - 结算账期: Int
    - 资质证照: List
    + 对账(账期: String): 对账单
}

class 采购订单 {
    - 单号: String
    - 订货日期: Date
    - 状态: 草稿/已下达/部分到货/已完成
    + 下达()
    + 跟踪到货()
}

class 采购明细 {
    - 订货数量: Int
    - 进价: Money
    + 计算金额(): Money
}

class 收货单 {
    - 单号: String
    - 收货时间: DateTime
    - 验收结果: 合格/部分拒收
    + 验收(批次: 库存批次): Boolean
    + 入库()
}

class 收货明细 {
    - 应收数量: Int
    - 实收数量: Int
    - 拒收原因: String
    + 计算差异(): Int
}

// ============================================================
// 四、业务实体：销售与结算（业务事件）
// ============================================================
class 销售单 {
    - 单号: String
    - 交易时间: DateTime
    - 渠道: 到店/POS/线上
    - 应收金额: Money
    - 实收金额: Money
    - 优惠金额: Money
    - 状态: 进行中/已支付/已撤销/已退货
    + 汇总(): Money
    + 打印小票()
    + 撤销()
}

class 销售明细 {
    - 行号: Int
    - 数量: Int
    - 单价: Money
    - 折扣: Money
    - 小计: Money
    + 计算小计(): Money
}

class 支付记录 {
    - 流水号: String
    - 支付渠道: 现金/银行卡/扫码/购物卡
    - 金额: Money
    - 结果: 成功/失败/已退款
    - 交易时间: DateTime
    + 发起支付(): Boolean
    + 退款(): Boolean
}

class 退货单 {
    - 单号: String
    - 退货原因: String
    - 退款金额: Money
    - 是否可二次销售: Boolean
    + 审核(授权人: 员工): Boolean
}

class 盘点单 {
    - 单号: String
    - 盘点日期: Date
    - 账面数量: Int
    - 实盘数量: Int
    + 生成差异(): Int
    + 报损(原因: String)
}

// ============================================================
// 五、业务工人（内部执行者）
// ============================================================
abstract class 员工 {
    - 工号: String
    - 姓名: String
    - 岗位: String
    + 登录系统(账号: String): Boolean
}

class 收银员 {
    - 收银台号: String
    - 授权额度: Money
    + 扫码(条码: String)
    + 收款(方式: String): 支付记录
}

class 理货员 {
    - 责任区域: String
    + 补货(货位: 货架陈列位)
    + 报损(数量: Int, 原因: String)
}

class 收货员 {
    - 班次: String
    + 验收(收货单: 收货单)
}

class 店长 {
    - 门店编码: String
    + 审批(单据: String): Boolean
    + 查看经营看板()
}

class 收银班次 {
    - 班次号: String
    - 开班时间: DateTime
    - 交班时间: DateTime
    - 备用金: Money
    - 现金实收: Money
    + 开班()
    + 交班对账(): 差异金额
}

// ============================================================
// 六、关系
// ============================================================
// --- 人 ---
会员 --|> 顾客 : 泛化
收银员 --|> 员工 : 泛化
理货员 --|> 员工 : 泛化
收货员 --|> 员工 : 泛化
店长 --|> 员工 : 泛化

顾客 "1" --> "0..*" 销售单 : 购买
会员 "1" --> "0..*" 退货单 : 申请

// --- 商品与价格 ---
商品 "*" --> "1" 品类 : 归属
商品 "1" --> "1" 库存 : 现有库存
库存 "1" *-- "0..*" 库存批次 : 分批存放
商品 "*" --> "0..*" 促销活动 : 参与
商品 "*" --> "0..1" 货架陈列位 : 陈列于

// --- 供应链 ---
供应商 "1" --> "0..*" 采购订单 : 接受订货
采购订单 "1" *-- "1..*" 采购明细 : 包含
采购明细 "*" --> "1" 商品 : 指向
采购订单 "1" --> "0..*" 收货单 : 到货生成
收货单 "1" *-- "1..*" 收货明细 : 包含
收货明细 "*" --> "1" 商品 : 指向
收货单 ..> 库存 : 入库增加
供应商 "1" --> "0..*" 收货单 : 送货

// --- 销售与结算 ---
销售单 "1" *-- "1..*" 销售明细 : 包含
销售明细 "*" --> "1" 商品 : 对应
销售单 "1" --> "1..*" 支付记录 : 通过…支付
销售单 "1" --> "1" 收银班次 : 归属
收银班次 "*" --> "1" 收银员 : 由…开班
退货单 "0..*" --> "1" 销售单 : 依据原单
退货单 "*" --> "1" 商品 : 退回
盘点单 "*" --> "1" 库存 : 核对
盘点单 "*" --> "1" 理货员 : 由…执行

// ============================================================
// 七、约束与说明
// ============================================================
notice "关键业务规则" {
    R1 明码标价：同一商品在同一门店同一时点只有一个生效售价。
    R2 促销优先：会员价与促销取"对顾客最有利"的一档，不叠加。
    R3 库存不为负：支付成功后才扣减库存，扣减失败需回滚交易。
    R4 小票唯一：一张销售单对应唯一小票号，退货必须凭原单号。
    R5 批次先进先出：生鲜按到期日先出，临期商品自动进入折价流程。
    R6 账实一致：收银班次交班时现金 + 非现金 = 系统应收。
}

notice "模型说明" {
    1. 本图为业务对象模型：既有业务实体（如 商品、销售单），
       也有业务工人（收银员、理货员、收货员、店长）及其班次对象。
    2. 组合（实心菱形）：销售单—销售明细、采购订单—采购明细、
       收货单—收货明细、库存—库存批次，整体销毁则部分随之销毁。
    3. 多重度用于表达业务规则，例如 销售单 1 : 1..* 销售明细
       表示"一张小票至少一件商品"。
}
